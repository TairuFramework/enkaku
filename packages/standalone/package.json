{
  "name": "@enkaku/standalone",
  "version": "0.20.0",
  "description": "Standalone client and server for Enkaku RPC",
  "keywords": [
    "json",
    "rpc",
    "client",
    "server"
  ],
  "homepage": "https://enkaku.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/enkaku",
    "directory": "packages/standalone"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del lib",
    "build:js": "swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@enkaku/client": "workspace:^",
    "@enkaku/server": "workspace:^",
    "@enkaku/transport": "workspace:^",
    "@sozai/runtime": "catalog:"
  },
  "devDependencies": {
    "@enkaku/protocol": "workspace:^",
    "@kokuin/token": "catalog:"
  }
}
