{
  "name": "@enkaku/react",
  "version": "0.20.0",
  "description": "React bindings for Enkaku RPC client",
  "keywords": [
    "rpc",
    "client",
    "react",
    "hooks",
    "enkaku"
  ],
  "homepage": "https://enkaku.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/enkaku",
    "directory": "packages/react"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del lib",
    "build:js": "swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@enkaku/client": "workspace:^",
    "canonicalize": "catalog:"
  },
  "devDependencies": {
    "@enkaku/protocol": "workspace:^",
    "@enkaku/standalone": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
