{
  "name": "@enkaku/socket",
  "version": "0.21.0",
  "description": "Socket transport for Enkaku RPC clients and servers",
  "keywords": [
    "transport",
    "rpc",
    "node",
    "socket",
    "ipc"
  ],
  "homepage": "https://enkaku.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/enkaku",
    "directory": "packages/socket"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del lib",
    "build:js": "del 'lib/**/*.js' && swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "del 'lib/**/*.d.ts' 'lib/**/*.d.ts.map' && tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@enkaku/otel": "workspace:^",
    "@enkaku/transport": "workspace:^",
    "@sozai/otel": "catalog:",
    "@sozai/stream": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
